rules_version = '2';

// ProviderGate FVVK – Firestore güvenlik kuralları
// Firebase konsolu > Firestore Database > Rules sekmesine yapıştırıp "Publish" deyin.
// Not: Konsoldan yapılan elle kayıtlar bu kurallardan etkilenmez.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    // Kullanıcı profilleri: herkes yalnızca kendi profilini okur.
    // Profiller şimdilik Firebase konsolundan elle oluşturulur.
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // Diğer her şey varsayılan olarak kapalı (sonraki adımlarda açılacak).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
