# Firebase Console > Proje ayarları > Genel > "Uygulamalarınız" > Web uygulaması
# Bu dosyayı .env.local olarak kopyalayıp değerleri doldurun.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=providergatefvvk.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=providergatefvvk
VITE_FIREBASE_STORAGE_BUCKET=providergatefvvk.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Kullanıcı adıyla girişte arka planda kullanılan iç e-posta alan adı
# (ör. "ahmet.yilmaz" -> "ahmet.yilmaz@users.providergatefvvk.app")
VITE_USERNAME_DOMAIN=users.providergatefvvk.app
